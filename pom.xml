<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>dev.xuanji</groupId>
    <artifactId>xuanji-parent</artifactId>
    <version>1.3.2</version>
    <packaging>pom</packaging>

    <name>XuanJi Parent</name>
    <description>璇玑机器人开发框架 - 父工程</description>
    <url>https://github.com/qunxing/xuanji-bot</url>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <modules>
        <module>xuanji-sdk</module>
        <module>xuanji-api</module>
        <module>xuanji-adapter-qqbot</module>
        <module>xuanji-core</module>
        <module>xuanji-console-server</module>
        <module>xuanji-scheduler</module>
        <module>xuanji-llm</module>
        <module>xuanji-plugin-groupadmin</module>
        <module>xuanji-plugin-test</module>
        <module>xuanji-starter</module>
    </modules>

    <properties>
        <!-- 基线 21+，开发环境 JDK 25 -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.xuanji</groupId>
                <artifactId>xuanji-sdk</artifactId>
                <version>1.3.2</version>
            </dependency>
            <dependency>
                <groupId>dev.xuanji</groupId>
                <artifactId>xuanji-api</artifactId>
                <version>1.3.2</version>
            </dependency>
            <dependency>
                <groupId>dev.xuanji</groupId>
                <artifactId>xuanji-adapter-qqbot</artifactId>
                <version>1.3.2</version>
            </dependency>
            <dependency>
                <groupId>dev.xuanji</groupId>
                <artifactId>xuanji-core</artifactId>
                <version>1.3.2</version>
            </dependency>
            <dependency>
                <groupId>dev.xuanji</groupId>
                <artifactId>xuanji-console-server</artifactId>
                <version>1.3.2</version>
            </dependency>
            <dependency>
                <groupId>dev.xuanji</groupId>
                <artifactId>xuanji-scheduler</artifactId>
                <version>1.3.2</version>
            </dependency>
            <dependency>
                <groupId>dev.xuanji</groupId>
                <artifactId>xuanji-llm</artifactId>
                <version>1.3.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- 发布构建（源码包/Javadoc/GPG 签名），日常 package 不触发 -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.8.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- distributionManagement 由 xuanji-api / xuanji-sdk 子模块各自定义（分别发布到不同制品库） -->
</project>
