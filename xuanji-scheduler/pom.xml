<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.xuanji</groupId>
        <artifactId>xuanji-parent</artifactId>
        <version>1.3.2</version>
    </parent>

    <artifactId>xuanji-scheduler</artifactId>
    <name>XuanJi Scheduler</name>
    <description>璇玑框架 - 定时任务模块（统一调度中枢：cron 解析、执行器、任务存储、控制台管理）</description>

    <dependencies>
        <dependency>
            <groupId>dev.xuanji</groupId>
            <artifactId>xuanji-core</artifactId>
        </dependency>

        <!-- SendReceipt / Target 等公共发送契约 -->
        <dependency>
            <groupId>dev.xuanji</groupId>
            <artifactId>xuanji-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Web MVC：定时任务管理接口（@XuanjiApi 前缀由 console-server 的 XuanjiApiRoutes 统一装配） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
