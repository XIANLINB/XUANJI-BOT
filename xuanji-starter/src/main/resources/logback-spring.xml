<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台输出：彩色可读 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%-40logger{36}) %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 文件输出：文本可读（移除 logstash JSON 编码器，换取 jar 体积 -4MB 并去掉 Jackson 2 依赖） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/xuanji-bot.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/xuanji-bot-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %-40logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 框架日志 -->
    <logger name="dev.xuanji" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
