<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.xuanji</groupId>
        <artifactId>xuanji-parent</artifactId>
        <version>1.3.4</version>
    </parent>

    <artifactId>xuanji-starter</artifactId>
    <name>XuanJi Starter</name>
    <description>璇玑框架 - 启动器（可执行应用入口）</description>

    <dependencies>
        <dependency>
            <groupId>dev.xuanji</groupId>
            <artifactId>xuanji-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.xuanji</groupId>
            <artifactId>xuanji-console-server</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.xuanji</groupId>
            <artifactId>xuanji-scheduler</artifactId>
        </dependency>
        <!-- AI 能力引擎（LLM 模块），默认打进 jar 开箱即用；裁减体积时删除本依赖即可回到基线 -->
        <dependency>
            <groupId>dev.xuanji</groupId>
            <artifactId>xuanji-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.xuanji</groupId>
            <artifactId>xuanji-adapter-qqbot</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 已移除 logstash-logback-encoder（绑定 Jackson 2.x 且体积 ~4MB）：文件日志改用普通文本 pattern（见 logback-spring.xml） -->

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 可执行 Fat JAR：spring-boot-maven-plugin 在 package 阶段默认即绑定 repackage，
                 无需再显式声明 execution，否则会 repackage 两次、把 BOOT-INF 应用类整个弄丢 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- 分平台瘦身：-Pwindows / -Plinux 时，package 后调用 scripts/slim-jar.py
                 裁剪 Playwright driver-bundle 内非目标平台的 node（jar 227MB → ~66MB）。
                 不激活 profile 时跳过（产出全平台通用 jar）。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>slim-driver-bundle</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${slim.python}</executable>
                            <workingDirectory>${project.basedir}/..</workingDirectory>
                            <arguments>
                                <argument>scripts/slim-jar.py</argument>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>--platform</argument>
                                <argument>${slim.platform}</argument>
                            </arguments>
                            <skip>${slim.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Windows 专属包：仅保留 win32_x64/node.exe -->
        <profile>
            <id>windows</id>
            <properties>
                <slim.platform>win</slim.platform>
                <slim.skip>false</slim.skip>
                <slim.python>python</slim.python>
            </properties>
        </profile>
        <!-- Linux 专属包：仅保留 linux + linux-arm64 -->
        <profile>
            <id>linux</id>
            <properties>
                <slim.platform>linux</slim.platform>
                <slim.skip>false</slim.skip>
                <slim.python>python3</slim.python>
            </properties>
        </profile>
    </profiles>

    <!-- 默认（无 profile）：不裁剪，产出全平台通用 jar -->
    <properties>
        <slim.platform>win</slim.platform>
        <slim.skip>true</slim.skip>
        <slim.python>python</slim.python>
    </properties>
</project>
