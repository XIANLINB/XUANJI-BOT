<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.xuanji</groupId>
        <artifactId>xuanji-parent</artifactId>
        <version>1.3.1</version>
    </parent>

    <artifactId>xuanji-api</artifactId>
    <name>XuanJi API</name>
    <description>璇玑框架 - 纯接口与模型（零 Spring 依赖方向演进中）</description>

    <distributionManagement>
        <snapshotRepository>
            <id>cnb-xuanji-api</id>
            <url>https://maven.cnb.cool/XuanJiBot/xuanji-api/-/packages/snapshots</url>
            <uniqueVersion>true</uniqueVersion>
        </snapshotRepository>
        <repository>
            <id>cnb-xuanji-api</id>
            <url>https://maven.cnb.cool/XuanJiBot/xuanji-api/-/packages/releases</url>
        </repository>
    </distributionManagement>

    <dependencies>
        <!-- Jackson 3（tools.jackson）：与 Boot 4 / Spring 7 默认一致，统一序列化栈 -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- PF4J：插件需继承 Plugin 基类（provided：运行时由框架核心 ClassLoader 提供） -->
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
            <version>3.15.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
