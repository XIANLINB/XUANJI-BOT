<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.xuanji</groupId>
        <artifactId>xuanji-parent</artifactId>
        <version>1.3.2</version>
    </parent>

    <artifactId>xuanji-sdk</artifactId>
    <name>XuanJi SDK</name>
    <description>璇玑插件开发 SDK — 插件开发者唯一需要的依赖，后续发布到 Maven Central</description>

    <repositories>
        <!-- SDK 依赖 xuanji-api（发布在另一个 CNB 制品库），需声明用于 Maven 解析与 verify-deploy -->
        <repository>
            <id>cnb-xuanji-api</id>
            <name>CNB XuanJi API Registry</name>
            <url>https://maven.cnb.cool/XuanJiBot/xuanji-api/-/packages/releases</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <distributionManagement>
        <snapshotRepository>
            <id>cnb-xuanji-sdk</id>
            <url>https://maven.cnb.cool/XuanJiBot/xuanji-sdk/-/packages/snapshots</url>
            <uniqueVersion>true</uniqueVersion>
        </snapshotRepository>
        <repository>
            <id>cnb-xuanji-sdk</id>
            <url>https://maven.cnb.cool/XuanJiBot/xuanji-sdk/-/packages/releases</url>
        </repository>
    </distributionManagement>

    <dependencies>
        <!-- SDK = api 能力封装 + 便捷工具类，插件开发者只需引入这一个 artifact -->
        <dependency>
            <groupId>dev.xuanji</groupId>
            <artifactId>xuanji-api</artifactId>
        </dependency>
    </dependencies>
</project>
