<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.xuanji</groupId>
        <artifactId>xuanji-parent</artifactId>
        <version>1.3.1</version>
    </parent>

    <artifactId>xuanji-plugin-groupadmin</artifactId>
    <name>XuanJi Plugin GroupAdmin</name>
    <description>群管插件 — 禁言 / 撤回 / 入群申请审批（正式版）</description>

    <!-- 从 CNB 公开 Maven 制品库引入框架 SDK/API（无需下载 jar，插件开发标准方式） -->
    <repositories>
        <repository>
            <id>cnb-xuanji-api</id>
            <name>CNB XuanJi API Registry</name>
            <url>https://maven.cnb.cool/XuanJiBot/xuanji-api/-/packages/releases</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
            <id>cnb-xuanji-sdk</id>
            <name>CNB XuanJi SDK Registry</name>
            <url>https://maven.cnb.cool/XuanJiBot/xuanji-sdk/-/packages/releases</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- 框架 SDK/API：从 CNB 制品库拉取，provided 运行时由框架核心 ClassLoader 提供 -->
        <dependency>
            <groupId>dev.xuanji</groupId>
            <artifactId>xuanji-sdk</artifactId>
            <version>1.3.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.xuanji</groupId>
            <artifactId>xuanji-api</artifactId>
            <version>1.3.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- PF4J 基类：插件需继承 Plugin（provided，运行时框架提供） -->
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
            <version>3.15.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Plugin-Id>groupadmin-plugin</Plugin-Id>
                            <Plugin-Class>XuanJi.plugin.groupadmin.GroupAdminPlugin</Plugin-Class>
                            <Plugin-Origin>official</Plugin-Origin>
                            <Plugin-Category>group-admin</Plugin-Category>
                            <Plugin-Version>1.0.0</Plugin-Version>
                            <Plugin-Provider>XuanJi Team</Plugin-Provider>
                            <Plugin-Description>群管理：禁言 / 撤回 / 入群申请审批</Plugin-Description>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
